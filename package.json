{
  "name": "nxip-terraform-plan-action",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Action that comments on Terraform PRs with the CIDR and IP-space utilization nxip would allocate, before you apply.",
  "type": "module",
  "scripts": {
    "build": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "overrides": {
    "undici": "^8.10.0"
  }
}
